# Supabase (https://app.supabase.com → Settings → API)
VITE_SUPABASE_URL=https://[VOTRE_SUPABASE_PROJECT_ID].supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique-supabase

# Agora.io (https://console.agora.io → Project Management)
VITE_AGORA_APP_ID=votre-agora-app-id

# OneSignal Push Notifications (https://app.onesignal.com → Settings → Keys & IDs)
VITE_ONESIGNAL_APP_ID=votre-onesignal-app-id

# Digitalpaye Mobile Money (https://digitalpaye.com → Dashboard)
VITE_DIGITALPAYE_PUBLIC_KEY=pk_test_votre_cle_publique
